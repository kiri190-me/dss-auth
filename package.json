{
  "name": "dss-auth",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --port 3100",
    "build": "next build --webpack",
    "start": "next start --port 3100",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "key:generate": "node --env-file=.env.local --import tsx scripts/generate-signing-key.ts",
    "client:register": "node --env-file=.env.local --import tsx scripts/register-client.ts",
    "test": "node --import tsx --test src/lib/crypto/hash.test.ts src/lib/crypto/public-jwk.test.ts src/lib/oidc/pkce.test.ts src/lib/oidc/redirect-uri.test.ts src/lib/oidc/authorize-params.test.ts src/lib/oidc/discovery-document.test.ts",
    "db:up": "docker compose --env-file .env.local up -d db-dev",
    "db:down": "docker compose --env-file .env.local down",
    "db:psql": "docker exec -it dss-auth-postgres-dev psql -U dss_auth_app -d dss_auth_dev",
    "admin:promote": "node --env-file=.env.local --import tsx scripts/promote-admin.ts",
    "check:oidc": "node --env-file=.env.local --import tsx scripts/e2e-oidc-check.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.10",
    "next": "^16.3.3",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
