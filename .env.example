# 이 파일은 예시용이며 실제 값이 아닙니다. 절대 실제 키/시크릿을 여기 넣지 마세요.
# 실제 값은 .env.local(Git 추적 제외)에만 저장합니다.

# ─── 기본 ────────────────────────────────────────────────────────────
# 이 서버가 스스로를 부르는 주소. ID 토큰의 iss 클레임과 discovery 문서에
# 그대로 들어가며, 각 시스템이 이 값을 대조합니다. 끝에 슬래시를 붙이지 마세요.
# 개발: http://localhost:3100
OIDC_ISSUER=http://localhost:3100

# ─── 데이터베이스 ─────────────────────────────────────────────────────
# 포트가 5434인 이유: A/S 관리 시스템의 DB가 5432/5433을 이미 쓰고 있어
# 두 프로젝트를 동시에 띄우려면 겹치면 안 됩니다.
DATABASE_URL=postgresql://dss_auth_app:CHANGE_ME@127.0.0.1:5434/dss_auth_dev

# docker-compose.yml이 읽는 값. 위 DATABASE_URL의 비밀번호와 같아야 합니다.
DEV_POSTGRES_PASSWORD=CHANGE_ME

# ─── RS256 서명 키 ────────────────────────────────────────────────────
# `npm run key:generate`이 keys/ 폴더에 키쌍을 만들고 kid를 알려줍니다.
# 개인키는 환경변수가 아니라 파일로 둡니다 — NAS에서 백업 대상이 폴더 하나로
# 명확해지고, 프로세스 목록이나 오류 로그로 샐 위험이 없습니다.
AUTH_KEYS_DIR=./keys
# 지금 서명에 사용할 키. keys/ 안의 공개키는 전부 JWKS로 노출되지만(옛 토큰
# 검증을 위해) 서명은 이 kid 하나로만 합니다.
AUTH_ACTIVE_KID=

# 인가 요청 파라미터를 로그인 화면 왕복 동안 나르는 짧은 수명 쿠키의 서명 키.
# 32바이트 이상 랜덤. 생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_TX_SECRET=

# ─── 카카오 로그인 ────────────────────────────────────────────────────
# 카카오 개발자 콘솔 > 앱 설정 > 앱 키 > REST API 키
KAKAO_CLIENT_ID=
# 카카오 개발자 콘솔 > 카카오 로그인 > 보안 > Client Secret (상태를 "사용함"으로)
KAKAO_CLIENT_SECRET=
# 카카오 콘솔에 등록한 값과 **문자 단위로 정확히** 같아야 합니다.
# request.url에서 만들어 쓰지 마세요 — 프록시/LAN 환경에서 값이 달라집니다.
KAKAO_REDIRECT_URI=http://localhost:3100/api/kakao/callback

# ─── 보안 스위치 ──────────────────────────────────────────────────────
# 클라이언트의 redirect_uri에 http를 허용할지. 기본 false(https만).
# 사내망 HTTP 단계에서만 true로 켜고, HTTPS 전환과 동시에 false로 되돌립니다.
# 되돌리는 것을 배포 체크리스트 항목으로 두세요.
OIDC_ALLOW_HTTP_REDIRECT_URIS=false
